REPORTING_NINJA_API_KEY=jouw_api_key_hier
PORT=3000

# Google Sheets-koppeling (optioneel): zelfde service-account als in het
# Google-Ads-project (google-ads-ai-sheet-account@woeler.iam.gserviceaccount.com).
# Klanten delen hun sheet met dit e-mailadres (als Kijker of Bewerker) om
# toegang te geven. Vul hieronder GOOGLE_SHEETS_CLIENT_EMAIL en
# GOOGLE_SHEETS_PRIVATE_KEY in (zelfde waarden als in Google-Ads-project/.env).
GOOGLE_SHEETS_CLIENT_EMAIL=naam@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Alternatief: volledige service-account JSON-sleutel als één regel, als je
# liever een ander/nieuw service-account gebruikt dan bovenstaande twee vars.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"naam@project.iam.gserviceaccount.com", ...}
