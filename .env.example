REPORTING_NINJA_API_KEY=jouw_api_key_hier
PORT=3000

# Google Sheets-koppeling (optioneel): volledige service-account JSON-sleutel
# als één regel. Maak een service-account aan in Google Cloud Console, schakel
# de Google Sheets API in, download de JSON-sleutel en plak die hier als één
# regel. Klanten delen hun sheet met het "client_email"-adres uit die sleutel
# (als Kijker) om toegang te geven.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"naam@project.iam.gserviceaccount.com", ...}
